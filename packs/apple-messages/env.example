# SSH connection for on-demand reads. See README.md for the alias and permissions.
# NANO_APPLE_MESSAGES_SSH_CONFIG=/data/apple-messages/ssh/config
# Opt in to automatic processing of direct mentions. Use nano-messages deny to exclude a chat.
# NANO_APPLE_MESSAGES_WATCH=on
# Also let Nano reply to direct mentions in chats that aren't denied.
# NANO_APPLE_MESSAGES_REPLY=on
