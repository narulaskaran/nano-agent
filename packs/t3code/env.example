# t3code pack (NANO_PACKS=core,mcp,t3code).

# T3 Code server as the container reaches it. Loopback works only with host networking
# on the T3 Code machine (see packs/vault/README.md).
NANO_T3CODE_URL=http://127.0.0.1:4096

# Address you open T3 Code at; links Nano sends are rewritten to it. Empty: unchanged.
NANO_T3CODE_WEB_URL=

# Access level when pairing: read-only, approval-required, auto-accept-edits, auto, full-access
NANO_T3CODE_ACCESS=approval-required
