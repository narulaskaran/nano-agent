# --- Required -------------------------------------------------------------
# Photon project (https://app.photon.codes -> your project -> Settings).
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
# Your own phone number in E.164 form. Only these senders are answered.
NANO_ALLOWED_USERS=+15551234567

# One model key. The default provider is OpenRouter; set the key for whichever
# provider NANO_MODEL names (OPENROUTER_API_KEY, DEEPSEEK_API_KEY,
# ANTHROPIC_API_KEY, OPENAI_API_KEY, GEMINI_API_KEY, ...).
OPENROUTER_API_KEY=
NANO_MODEL=openrouter/deepseek/deepseek-v4.1-flash
# Optional: OpenRouter upstream providers to prefer, in order (names as in its Activity page). Left
# unset, OpenRouter may spread a run's first requests over several providers, each starting with a
# cold prompt cache billed at the full input price. Other providers still serve requests if these are
# down. Pick ones that serve NANO_MODEL and cache prompts.
# NANO_OPENROUTER_PROVIDERS=OpenInference,Wafer

# --- Optional -------------------------------------------------------------
# Web search (https://brave.com/search/api). Without it Nano can still fetch pages.
BRAVE_SEARCH_API_KEY=
# Owner of ./data on the host, if your user is not uid 1000 (`id -u`, `id -g`).
# NANO_UID=1000
# NANO_GID=1000
# Fallback timezone until Nano learns yours in the first conversation.
TZ=UTC
# Hours of silence before the next text starts a fresh context window.
NANO_IDLE_HOURS=4
# A text sent while Nano is working: "interrupt" (cancel an unsent reply, answer everything at once),
# "steer" (join at the next model call) or "queue" (its own turn, afterwards).
NANO_INBOUND=interrupt
# Each text first gets one fast decision from the decision model (see Decisions below): a plain
# "thanks" gets no reply, slow work is handed to a background task, and a new topic after
# NANO_TOPIC_IDLE_MINUTES of quiet starts a fresh context window. "off" turns it off. Needs a decision model.
NANO_ROUTER=on
NANO_TOPIC_IDLE_MINUTES=20
# Packs to load (folders under packs/, or private ones under data/packs/).
# The vault pack's settings are in packs/vault/env.example.
NANO_PACKS=core
# Thinking effort: off, minimal, low, medium, high.
NANO_THINKING=low
# Background tasks (sub-sessions for heavy work): how many run at once, and when one is stopped.
NANO_MAX_TASKS=3
NANO_TASK_TIMEOUT_MINUTES=30

# Decisions (nano-decide, the router, gates): a decision model behind any endpoint that speaks the
# System One API, for example Jev on OpenRouter or a self-hosted Clef server. With the vault, its
# Decisions setting wins. Otherwise NANO_DECIDE_URL is the full URL of the decision endpoint, with
# NANO_DECIDE_MODEL and, if the endpoint needs one, NANO_DECIDE_API_KEY. Left unset, decisions use
# OpenRouter with OPENROUTER_API_KEY and typesafe/jev-1.14. Requests to OpenRouter always require
# zero data retention.
# NANO_DECIDE_URL=http://host.docker.internal:30000/v1/systemone
# NANO_DECIDE_MODEL=
# NANO_DECIDE_API_KEY=

# Local model (optional): an OpenAI-compatible endpoint you run, e.g. llama.cpp or Ollama.
# Used for background tasks and scheduled jobs marked "local" or "private", the ask_local tool
# and the nano-local command. Work marked private is refused when this is unset; it never falls
# back to the cloud model. A private task's final answer does go to the main model.
# From inside Docker, reach the host as http://host.docker.internal:<port>/v1 (on Linux, map it
# with `extra_hosts: ["host.docker.internal:host-gateway"]` in compose.override.yaml).
NANO_LOCAL_MODEL=
NANO_LOCAL_BASE_URL=
NANO_LOCAL_API_KEY=
# Context window of the local model, in tokens.
NANO_LOCAL_CONTEXT=32768


# Optional trusted local event spools, comma separated. Successful tasks keep .done receipts.
# NANO_EVENT_OUTBOX_DIRS=/events/inbox
